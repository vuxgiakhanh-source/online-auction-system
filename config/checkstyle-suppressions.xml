<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Stable API / persistence names; renaming would break protocol, clients, and SQL. -->
  <suppress checks="AbbreviationAsWordInName" files="[\\/]dto[\\/].*"/>
  <suppress checks="AbbreviationAsWordInName" files="[\\/]dao[\\/].*"/>
  <suppress checks="AbbreviationAsWordInName" files=".*DTO\.java"/>
  <suppress checks="AbbreviationAsWordInName" files=".*DTOs\.java"/>
  <suppress checks="AbbreviationAsWordInName" files=".*DAO\.java"/>
  <suppress checks="AbbreviationAsWordInName" files=".*Mapper\.java"/>
  <suppress checks="AbbreviationAsWordInName" files="FAQ\.java"/>
  <suppress checks="AbbreviationAsWordInName" message=".*DAO.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*DTO.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*DTOs.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*Id.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*UUID.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*URL.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*\bWS\b.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*SQL.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*\bDB\b.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*\bIP\b.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*API.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*HTTP.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*JSON.*"/>
  <suppress checks="AbbreviationAsWordInName" message=".*FAQ.*"/>
  <suppress checks="AbbreviationAsWordInName" files="[\\/]iservice[\\/].*"/>
  <suppress checks="AbbreviationAsWordInName" message="^I[A-Z].*"/>

  <!-- DTO / DAO layers: data shapes and persistence; javadoc on every accessor adds noise. -->
  <suppress checks="MissingJavadocMethod" files="[\\/]dto[\\/].*"/>
  <suppress checks="MissingJavadocType" files="[\\/]dto[\\/].*"/>
  <suppress checks="MissingJavadocType" files=".*DTOs\.java"/>
  <suppress checks="SummaryJavadoc" files="[\\/]dto[\\/].*"/>
  <suppress checks="JavadocParagraph" files="[\\/]dto[\\/].*"/>
  <suppress checks="MissingJavadocMethod" files="[\\/]dao[\\/].*"/>
  <suppress checks="MissingJavadocType" files="[\\/]dao[\\/].*"/>
  <suppress checks="SummaryJavadoc" files="[\\/]dao[\\/].*"/>
  <suppress checks="MissingJavadocMethod" files="NotificationMessages\.java"/>
  <suppress checks="MissingJavadocMethod" files=".*Mapper\.java"/>
  <suppress checks="MissingJavadocMethod" files="ServerBroadcastNotifier\.java"/>
  <suppress checks="MissingJavadocType" files="[\\/]exception[\\/].*"/>

  <!-- Tests -->
  <suppress checks="MissingJavadocMethod" files="[\\/]test[\\/].*"/>
  <suppress checks="MissingJavadocType" files="[\\/]test[\\/].*"/>
  <suppress checks="SummaryJavadoc" files="[\\/]test[\\/].*"/>
  <suppress checks="JavadocParagraph" files="[\\/]test[\\/].*"/>
  <suppress checks="AtclauseOrder" files="[\\/]test[\\/].*"/>
  <suppress checks="InvalidJavadocPosition" files="[\\/]test[\\/].*"/>
</suppressions>
