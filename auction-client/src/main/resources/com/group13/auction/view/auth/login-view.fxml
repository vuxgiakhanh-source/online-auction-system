<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0"
           stylesheets="@../../css/auth.css"
           styleClass="screen-root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.group13.auction.ui.controller.auth.LoginController">

    <Pane styleClass="background-layer"/>

    <VBox alignment="CENTER" fillWidth="false">
        <StackPane maxWidth="700.0"
                   minHeight="540.0"
                   prefHeight="540.0"
                   prefWidth="700.0"
                   styleClass="auth-panel">

            <VBox alignment="TOP_CENTER" fillWidth="false" spacing="24.0">
                <padding>
                    <Insets top="26.0" right="54.0" bottom="30.0" left="54.0"/>
                </padding>

                <ImageView fitWidth="430.0" preserveRatio="true">
                    <Image url="@../../assets/images/logo.png"/>
                </ImageView>

                <HBox alignment="CENTER" spacing="28.0">
                    <Button mnemonicParsing="false"
                            styleClass="active-tab"
                            text="Đăng nhập"/>

                    <Button mnemonicParsing="false"
                            onAction="#handleGoToRegister"
                            styleClass="ghost-tab"
                            text="Đăng ký"/>
                </HBox>

                <VBox alignment="CENTER" fillWidth="false" spacing="20.0">
                    <TextField fx:id="usernameField"
                               promptText="Tên đăng nhập"
                               styleClass="auth-input"/>

                    <PasswordField fx:id="passwordField"
                                   promptText="Mật khẩu"
                                   styleClass="auth-input"/>
                </VBox>

                <Button mnemonicParsing="false"
                        onAction="#handleSignIn"
                        styleClass="primary-action-button"
                        text="Sign in"/>

                <HBox alignment="CENTER" spacing="4.0">
                    <Label styleClass="helper-link"
                           text="Chưa có tài khoản?"/>

                    <Button mnemonicParsing="false"
                            onAction="#handleGoToRegister"
                            styleClass="text-link-button"
                            text="Hãy đăng ký."/>
                </HBox>
            </VBox>
        </StackPane>
    </VBox>

    <VBox alignment="BOTTOM_RIGHT"
          maxWidth="170.0"
          pickOnBounds="false"
          spacing="4.0"
          StackPane.alignment="BOTTOM_RIGHT">
        <padding>
            <Insets bottom="8.0" right="16.0"/>
        </padding>

        <HBox alignment="CENTER_RIGHT" spacing="4.0">
            <ImageView fitHeight="38.0" preserveRatio="true">
                <Image url="@../../assets/images/mascot-version-2.png"/>
            </ImageView>

            <ImageView fitHeight="34.0" preserveRatio="true">
                <Image url="@../../assets/icons/accent/icon-chatbot.png"/>
            </ImageView>
        </HBox>

        <Label styleClass="chatbot-label" text="Chat with OMNI"/>
        <Label styleClass="signature-label" text="by CKNT team"/>
    </VBox>
</StackPane>