<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            stylesheets="@../../css/seller.css"
            styleClass="screen-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group13.auction.ui.controller.seller.CreateAuctionController">

    <Pane prefHeight="720.0" prefWidth="1280.0" styleClass="background-layer"/>

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                pannable="true"
                styleClass="page-scroll-pane"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">
        <VBox spacing="20.0">
        <padding>
            <Insets top="26.0" right="42.0" bottom="26.0" left="42.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Button mnemonicParsing="false"
                    onAction="#handleBackToSellerList"
                    styleClass="seller-ghost-button"
                    text="← Danh sách phiên"/>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fitWidth="210.0" preserveRatio="true">
                    <Image url="@../../assets/images/logo.png"/>
                </ImageView>

                <ImageView fitHeight="44.0" preserveRatio="true">
                    <Image url="@../../assets/images/mascot-version-1.png"/>
                </ImageView>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <ProgressIndicator fx:id="loadingIndicator"
                               maxHeight="28.0"
                               maxWidth="28.0"
                               prefHeight="28.0"
                               prefWidth="28.0"
                               visible="false"
                               managed="false"/>
        </HBox>

        <!-- Title -->
        <VBox spacing="6.0">
            <Label text="Tạo phiên đấu giá"
                   styleClass="seller-page-title"/>

            <Label text="Nhập thông tin sản phẩm và thiết lập phiên đấu giá. Ảnh sản phẩm sẽ được upload trước khi gửi yêu cầu tạo phiên."
                   wrapText="true"
                   styleClass="seller-page-subtitle"/>
        </VBox>

        <!-- Form -->
            <VBox spacing="18.0">

                <!-- Product section -->
                <VBox spacing="18.0" styleClass="seller-form-section">
                    <padding>
                        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Thông tin sản phẩm" styleClass="seller-card-title"/>

                        <Label text="Item"
                               styleClass="seller-section-badge"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Các thông tin này dùng để tạo sản phẩm đấu giá."
                               styleClass="seller-muted-text"/>
                    </HBox>

                    <GridPane hgap="18.0" vgap="16.0">
                        <columnConstraints>
                            <javafx.scene.layout.ColumnConstraints percentWidth="50.0"/>
                            <javafx.scene.layout.ColumnConstraints percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox spacing="7.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Tên sản phẩm" styleClass="seller-form-label"/>
                            <TextField fx:id="itemNameField"
                                       promptText="Nhập tên sản phẩm"
                                       styleClass="seller-text-field"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Loại sản phẩm" styleClass="seller-form-label"/>
                            <ComboBox fx:id="categoryComboBox"
                                      prefWidth="520.0"
                                      styleClass="seller-combo-box"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label fx:id="extraField1Label"
                                   text="Thông tin mở rộng 1"
                                   styleClass="seller-form-label"/>
                            <TextField fx:id="extraField1"
                                       styleClass="seller-text-field"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label fx:id="extraField2Label"
                                   text="Thông tin mở rộng 2"
                                   styleClass="seller-form-label"/>
                            <TextField fx:id="extraField2"
                                       styleClass="seller-text-field"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label fx:id="extraField3Label"
                                   text="Thông tin mở rộng 3"
                                   styleClass="seller-form-label"/>
                            <TextField fx:id="extraField3"
                                       styleClass="seller-text-field"/>
                        </VBox>
                    </GridPane>

                    <VBox spacing="7.0">
                        <Label text="Mô tả sản phẩm" styleClass="seller-form-label"/>
                        <TextArea fx:id="descriptionArea"
                                  prefRowCount="5"
                                  promptText="Mô tả đặc điểm, tình trạng, phụ kiện hoặc thông tin cần lưu ý."
                                  wrapText="true"
                                  styleClass="seller-text-area"/>
                    </VBox>

                    <VBox spacing="8.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Ảnh sản phẩm" styleClass="seller-form-label"/>
                            <Label text="Tối đa 3 ảnh, mỗi ảnh không quá 2MB."
                                   styleClass="seller-muted-text"/>
                        </HBox>

                        <ListView fx:id="selectedImagesListView"
                                  prefHeight="112.0"
                                  styleClass="seller-image-list"/>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Button fx:id="chooseImagesButton"
                                    mnemonicParsing="false"
                                    onAction="#handleChooseImages"
                                    styleClass="seller-secondary-button"
                                    text="Chọn ảnh"/>

                            <Button fx:id="removeImageButton"
                                    mnemonicParsing="false"
                                    onAction="#handleRemoveSelectedImage"
                                    styleClass="seller-ghost-button"
                                    text="Xóa ảnh đã chọn"/>

                            <Button fx:id="clearImagesButton"
                                    mnemonicParsing="false"
                                    onAction="#handleClearImages"
                                    styleClass="seller-ghost-button"
                                    text="Xóa toàn bộ ảnh"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Auction section -->
                <VBox spacing="18.0" styleClass="seller-form-section">
                    <padding>
                        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="Thông tin phiên đấu giá" styleClass="seller-card-title"/>

                        <Label text="Auction"
                               styleClass="seller-section-badge"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Các thông tin này dùng để tạo phiên đấu giá."
                               styleClass="seller-muted-text"/>
                    </HBox>

                    <GridPane hgap="18.0" vgap="16.0">
                        <columnConstraints>
                            <javafx.scene.layout.ColumnConstraints percentWidth="50.0"/>
                            <javafx.scene.layout.ColumnConstraints percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox spacing="7.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Giá khởi điểm" styleClass="seller-form-label"/>
                            <TextField fx:id="startingPriceField"
                                       promptText="Ví dụ: 1000000"
                                       styleClass="seller-text-field"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Giá sàn" styleClass="seller-form-label"/>
                            <TextField fx:id="reservePriceField"
                                       promptText="Ví dụ: 1500000"
                                       styleClass="seller-text-field"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Ngày bắt đầu" styleClass="seller-form-label"/>
                            <DatePicker fx:id="startDatePicker"
                                        prefWidth="520.0"
                                        styleClass="seller-date-picker"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Giờ bắt đầu" styleClass="seller-form-label"/>
                            <TextField fx:id="startTimeField"
                                       promptText="HH:mm"
                                       styleClass="seller-text-field"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Ngày kết thúc" styleClass="seller-form-label"/>
                            <DatePicker fx:id="endDatePicker"
                                        prefWidth="520.0"
                                        styleClass="seller-date-picker"/>
                        </VBox>

                        <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Giờ kết thúc" styleClass="seller-form-label"/>
                            <TextField fx:id="endTimeField"
                                       promptText="HH:mm"
                                       styleClass="seller-text-field"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Submit bar -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="seller-form-action-bar">
                    <Button fx:id="createButton"
                            mnemonicParsing="false"
                            onAction="#handleCreateAuction"
                            styleClass="seller-primary-button"
                            text="Tạo phiên đấu giá"/>

                    <Button fx:id="resetButton"
                            mnemonicParsing="false"
                            onAction="#handleResetForm"
                            styleClass="seller-secondary-button"
                            text="Đặt lại"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="statusLabel"
                           text="Sẵn sàng."
                           styleClass="seller-muted-text"/>
                </HBox>
            </VBox>

        <!-- Chatbot launcher + signature -->
        <HBox alignment="BOTTOM_RIGHT" spacing="8.0">
            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="2.0">
                <fx:include source="../shared/chatbot-launcher.fxml"/>

                <Label styleClass="signature-label" text="by CKNT team"/>
            </VBox>
        </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>