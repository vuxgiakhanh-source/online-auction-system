<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.chatbot.ChatbotController"
      styleClass="page-panel" spacing="10" VBox.vgrow="ALWAYS">
    <HBox spacing="10">
        <ComboBox fx:id="categoryBox" prefWidth="140"/>
        <Button text="Tải FAQ" onAction="#onLoadFaq" styleClass="secondary-action-button"/>
    </HBox>
    <ListView fx:id="faqList" prefHeight="120"/>
    <HBox spacing="10">
        <TextField fx:id="queryField" HBox.hgrow="ALWAYS" promptText="Câu hỏi..."/>
        <Button text="Hỏi" onAction="#onAsk" styleClass="primary-action-button"/>
    </HBox>
    <TextArea fx:id="answerArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true"/>
</VBox>
