<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        prefWidth="1280.0"
        prefHeight="720.0"
        styleClass="screen-root"
        stylesheets="@../../css/admin.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.group13.auction.ui.controller.admin.AdminDashboardController">

    <VBox spacing="24.0" styleClass="admin-page">
        <padding>
            <Insets top="36.0" right="48.0" bottom="36.0" left="48.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="6.0">
                <Label fx:id="titleLabel" text="Bảng điều khiển quản trị" styleClass="page-title"/>
                <Label
                        fx:id="accessStatusLabel"
                        text="Đang kiểm tra quyền quản trị..."
                        styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="backButton"
                    text="Về trang chính"
                    styleClass="secondary-button"
                    onAction="#handleBackToMain"/>
        </HBox>

        <VBox spacing="10.0" styleClass="admin-info-panel">
            <Label text="Tổng quan hệ thống" styleClass="section-title"/>
            <Label
                    fx:id="statisticsStatusLabel"
                    text="API thống kê dashboard hiện chưa khả dụng."
                    wrapText="true"
                    styleClass="muted-label"/>
            <Label
                    fx:id="supportedModulesLabel"
                    text="Các module được hỗ trợ"
                    wrapText="true"
                    styleClass="muted-label"/>
        </VBox>

        <HBox spacing="18.0" styleClass="admin-card-row">
            <VBox spacing="12.0" styleClass="admin-nav-card" HBox.hgrow="ALWAYS">
                <Label text="Người dùng" styleClass="card-title"/>
                <Label
                        text="Xem tài khoản, khóa hoặc mở khóa người dùng thông qua API quản trị."
                        wrapText="true"
                        styleClass="card-description"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button
                        fx:id="usersButton"
                        text="Quản lý người dùng"
                        maxWidth="Infinity"
                        styleClass="primary-button"
                        onAction="#handleOpenUserModeration"/>
            </VBox>

            <VBox spacing="12.0" styleClass="admin-nav-card" HBox.hgrow="ALWAYS">
                <Label text="Phiên đấu giá" styleClass="card-title"/>
                <Label
                        text="Xem toàn bộ phiên đấu giá và hủy phiên không hợp lệ theo lý do được hỗ trợ."
                        wrapText="true"
                        styleClass="card-description"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button
                        fx:id="auctionsButton"
                        text="Quản lý phiên đấu giá"
                        maxWidth="Infinity"
                        styleClass="primary-button"
                        onAction="#handleOpenAuctionModeration"/>
            </VBox>
        </HBox>

        <HBox spacing="18.0" styleClass="admin-card-row">
            <VBox spacing="12.0" styleClass="admin-nav-card" HBox.hgrow="ALWAYS">
                <Label text="Duyệt quyền Seller" styleClass="card-title"/>
                <Label
                        text="Duyệt quyền Seller bằng API backend hiện có."
                        wrapText="true"
                        styleClass="card-description"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button
                        fx:id="sellersButton"
                        text="Duyệt Seller"
                        maxWidth="Infinity"
                        styleClass="primary-button"
                        onAction="#handleOpenSellerApproval"/>
            </VBox>

            <VBox spacing="12.0" styleClass="admin-nav-card" HBox.hgrow="ALWAYS">
                <Label text="Báo cáo chất lượng" styleClass="card-title"/>
                <Label
                        text="Xem các báo cáo chất lượng do người dùng gửi và duyệt hoặc từ chối."
                        wrapText="true"
                        styleClass="card-description"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button
                        fx:id="reportsButton"
                        text="Duyệt báo cáo"
                        maxWidth="Infinity"
                        styleClass="primary-button"
                        onAction="#handleOpenReportReview"/>
            </VBox>
        </HBox>

        <!-- Signature -->
        <HBox alignment="BOTTOM_RIGHT">
            <Region HBox.hgrow="ALWAYS"/>

            <Label styleClass="signature-label" text="by CKNT team"/>
        </HBox>
    </VBox>
</StackPane>