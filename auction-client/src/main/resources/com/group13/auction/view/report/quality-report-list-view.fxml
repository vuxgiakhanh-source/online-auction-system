<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        prefWidth="1280.0"
        prefHeight="720.0"
        styleClass="screen-root"
        stylesheets="@../../css/report.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.group13.auction.ui.controller.report.QualityReportListController">

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                pannable="true"
                styleClass="page-scroll-pane">
        <VBox spacing="20.0" styleClass="report-page">
        <padding>
            <Insets top="32.0" right="44.0" bottom="32.0" left="44.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="6.0">
                <Label fx:id="pageTitleLabel" text="Báo cáo chất lượng" styleClass="page-title"/>
                <Label fx:id="pageSubtitleLabel"
                       text="Theo dõi trạng thái báo cáo chất lượng."
                       wrapText="true"
                       styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="openOrdersButton"
                    text="Đơn hàng của tôi"
                    styleClass="secondary-button"
                    onAction="#handleOpenOrders"/>
            <Button fx:id="refreshButton"
                    text="Tải lại"
                    styleClass="secondary-button"
                    onAction="#handleRefresh"/>
            <Button fx:id="backButton"
                    text="Quay lại"
                    styleClass="secondary-button"
                    onAction="#handleBack"/>
        </HBox>

        <HBox spacing="18.0" VBox.vgrow="ALWAYS">
            <VBox spacing="12.0" styleClass="form-panel" HBox.hgrow="ALWAYS">
                <Label text="Danh sách báo cáo" styleClass="section-title"/>
                <Label fx:id="emptyStateLabel"
                       text="Chưa có báo cáo."
                       styleClass="muted-label"/>

                <TableView fx:id="reportTable"
                           VBox.vgrow="ALWAYS"
                           styleClass="report-table">
                    <columns>
                        <TableColumn fx:id="itemColumn" text="Sản phẩm" prefWidth="220.0"/>
                        <TableColumn fx:id="counterpartyColumn" text="Đối tác" prefWidth="140.0"/>
                        <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="140.0"/>
                        <TableColumn fx:id="createdAtColumn" text="Thời gian" prefWidth="160.0"/>
                        <TableColumn fx:id="auctionIdColumn" text="Mã phiên" prefWidth="180.0"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="12.0" prefWidth="420.0" styleClass="form-panel">
                <Label text="Chi tiết báo cáo" styleClass="section-title"/>
                <TextArea fx:id="reportDetailArea"
                          editable="false"
                          wrapText="true"
                          prefRowCount="18"
                          VBox.vgrow="ALWAYS"
                          styleClass="form-area"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <ProgressIndicator fx:id="loadingIndicator"
                               maxHeight="24.0"
                               maxWidth="24.0"
                               visible="false"
                               managed="false"/>
            <Label fx:id="statusLabel" text="" styleClass="status-label"/>
        </HBox>
        </VBox>
    </ScrollPane>
</StackPane>
