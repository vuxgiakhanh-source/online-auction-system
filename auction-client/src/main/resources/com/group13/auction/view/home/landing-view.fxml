<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            stylesheets="@../../css/home.css"
            styleClass="screen-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group13.auction.ui.controller.home.LandingController">

    <Pane prefHeight="720.0"
          prefWidth="1280.0"
          styleClass="background-layer"/>

    <!-- Header tối giản: không thêm search/ranking/khám phá vì backend chưa support rõ. -->
    <HBox alignment="CENTER_LEFT"
          spacing="18.0"
          AnchorPane.leftAnchor="18.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.topAnchor="16.0">

        <ImageView fitWidth="126.0" preserveRatio="true">
            <Image url="@../../assets/images/logo.png"/>
        </ImageView>

        <Region HBox.hgrow="ALWAYS"/>

        <Button mnemonicParsing="false"
                onAction="#handleGoToLogin"
                styleClass="landing-login-button"
                text="Đăng nhập"/>

        <Button mnemonicParsing="false"
                onAction="#handleGoToRegister"
                styleClass="landing-register-button"
                text="Đăng ký"/>
    </HBox>

    <!-- Hero content: gọn hơn để chừa hơn nửa không gian phía dưới. -->
    <VBox alignment="CENTER"
          spacing="8.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="102.0">

        <Label text="Nền tảng ĐẤU GIÁ TRỰC TUYẾN"
               styleClass="landing-main-title"/>

        <Label text="duy nhất bạn cần"
               styleClass="landing-main-title"/>

        <VBox alignment="CENTER">
            <Label text="Đấu giá trực tuyến hàng nghìn sản phẩm độc đáo."
                   styleClass="landing-main-subtitle"/>

            <Label text="Săn đồ hiếm, đồ cổ và đồ điện tử với mức giá do bạn quyết định."
                   styleClass="landing-main-subtitle"/>
        </VBox>

        <Region prefHeight="8.0"/>

        <Button mnemonicParsing="false"
                onAction="#handleStart"
                styleClass="landing-main-start-button"
                text="BẮT ĐẦU  ➜"/>
    </VBox>

    <!-- Chatbot floating widget. -->
    <VBox alignment="BOTTOM_RIGHT"
          maxWidth="170.0"
          pickOnBounds="false"
          spacing="4.0"
          AnchorPane.bottomAnchor="8.0"
          AnchorPane.rightAnchor="16.0">

        <HBox alignment="CENTER_RIGHT" spacing="4.0">
            <ImageView fitHeight="38.0" preserveRatio="true">
                <Image url="@../../assets/images/mascot-version-2.png"/>
            </ImageView>

            <ImageView fitHeight="34.0" preserveRatio="true">
                <Image url="@../../assets/icons/accent/icon-chatbot.png"/>
            </ImageView>
        </HBox>

        <Label styleClass="chatbot-label" text="Chat with OMNI"/>
        <Label styleClass="signature-label" text="by CKNT team"/>
    </VBox>
</AnchorPane>