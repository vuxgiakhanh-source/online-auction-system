<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0"
           stylesheets="@../../css/app.css"
           styleClass="screen-root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.group13.auction.ui.controller.home.LandingController">
    <Pane styleClass="background-layer"/>

    <VBox alignment="CENTER" maxWidth="720.0" spacing="18.0">
        <padding>
            <Insets left="48.0" right="48.0" top="48.0" bottom="48.0"/>
        </padding>
        <Label styleClass="home-title" text="Trang chủ tạm thời"/>
        <Label styleClass="home-subtitle"
               text="Đã điều hướng thành công từ màn hình đăng nhập/đăng ký. Phần này em có thể xây tiếp sau."/>
        <Button mnemonicParsing="false" onAction="#handleBackToLogin"
                styleClass="secondary-action-button" text="Quay lại đăng nhập"/>
    </VBox>
</StackPane>
