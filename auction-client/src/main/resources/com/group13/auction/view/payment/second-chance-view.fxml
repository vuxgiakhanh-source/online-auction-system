<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.payment.SecondChanceController"
      styleClass="page-panel" spacing="12">
    <Label fx:id="offerLabel" wrapText="true"/>
    <HBox spacing="10">
        <Button text="Chấp nhận" onAction="#onAccept" styleClass="primary-action-button"/>
        <Button text="Từ chối" onAction="#onDecline" styleClass="secondary-action-button"/>
    </HBox>
</VBox>
