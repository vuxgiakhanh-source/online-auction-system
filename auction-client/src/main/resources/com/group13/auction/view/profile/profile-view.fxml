<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        prefWidth="1280.0"
        prefHeight="720.0"
        styleClass="screen-root"
        stylesheets="@../../css/profile.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.group13.auction.ui.controller.profile.ProfileController">

    <VBox spacing="20.0" styleClass="profile-page">
        <padding>
            <Insets top="32.0" right="44.0" bottom="32.0" left="44.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="6.0">
                <Label text="Hồ sơ cá nhân" styleClass="page-title"/>
                <Label
                        text="Quản lý thông tin tài khoản, vai trò và trạng thái sử dụng OmniBid."
                        styleClass="page-subtitle"
                        wrapText="true"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="refreshButton"
                    text="Tải lại"
                    styleClass="secondary-button"
                    onAction="#handleRefresh"/>

            <Button
                    text="Về trang chính"
                    styleClass="secondary-button"
                    onAction="#handleBackToHome"/>
        </HBox>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS"
                styleClass="profile-scroll-pane">
            <VBox spacing="18.0" styleClass="profile-content">
                <padding>
                    <Insets top="2.0" right="4.0" bottom="4.0" left="4.0"/>
                </padding>

                <VBox spacing="14.0" styleClass="profile-section-card">
                    <Label text="Thông tin tài khoản" styleClass="profile-section-title"/>

                    <GridPane hgap="18.0" vgap="12.0" styleClass="profile-info-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="22.0"/>
                            <ColumnConstraints percentWidth="28.0"/>
                            <ColumnConstraints percentWidth="22.0"/>
                            <ColumnConstraints percentWidth="28.0"/>
                        </columnConstraints>

                        <Label
                                text="Tên đăng nhập"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="usernameLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Email"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="2"/>
                        <Label
                                fx:id="emailLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Vai trò"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="rolesLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Trạng thái"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="2"/>
                        <Label
                                fx:id="accountStatusLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Đánh giá"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="ratingLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Đã khôi phục"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="2"/>
                        <Label
                                fx:id="restoredLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="3"/>
                    </GridPane>
                </VBox>

                <VBox spacing="14.0" styleClass="profile-section-card">
                    <Label text="Ví tài khoản" styleClass="profile-section-title"/>

                    <GridPane hgap="18.0" vgap="12.0" styleClass="profile-info-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="22.0"/>
                            <ColumnConstraints percentWidth="28.0"/>
                            <ColumnConstraints percentWidth="22.0"/>
                            <ColumnConstraints percentWidth="28.0"/>
                        </columnConstraints>

                        <Label
                                text="Tổng số dư"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="balanceLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Số dư khả dụng"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="2"/>
                        <Label
                                fx:id="availableBalanceLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Đang giữ đặt cọc"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="lockedDepositLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Ngày tạo tài khoản"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="2"/>
                        <Label
                                fx:id="createdAtLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Cập nhật lần cuối"
                                styleClass="profile-field-title"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="updatedAtLabel"
                                text="--"
                                wrapText="true"
                                styleClass="profile-field-value"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="1"
                                GridPane.columnSpan="3"/>
                    </GridPane>
                </VBox>

                <VBox
                        fx:id="sellerRequestCard"
                        spacing="14.0"
                        styleClass="profile-section-card">
                    <Label text="Quyền Seller" styleClass="profile-section-title"/>

                    <Label
                            fx:id="sellerRequestHintLabel"
                            text="Bạn có thể gửi yêu cầu mở quyền Seller cho tài khoản này."
                            wrapText="true"
                            styleClass="profile-muted-text"/>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button
                                fx:id="requestSellerRoleButton"
                                text="Yêu cầu quyền Seller"
                                styleClass="primary-button"
                                onAction="#handleRequestSellerRole"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <VBox spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <ProgressIndicator
                        fx:id="loadingIndicator"
                        prefWidth="24.0"
                        prefHeight="24.0"
                        visible="false"
                        managed="false"/>

                <Label
                        fx:id="statusLabel"
                        text="Sẵn sàng."
                        wrapText="true"
                        styleClass="status-label"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox alignment="BOTTOM_RIGHT" spacing="8.0">
                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <fx:include source="../shared/chatbot-launcher.fxml"/>

                    <Label styleClass="signature-label" text="by CKNT team"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</StackPane>