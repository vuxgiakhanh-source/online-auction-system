<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        prefWidth="1280.0"
        prefHeight="720.0"
        styleClass="screen-root"
        stylesheets="@../../css/profile.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.group13.auction.ui.controller.profile.ProfileController">

    <VBox spacing="20.0" styleClass="profile-page">
        <padding>
            <Insets top="32.0" right="44.0" bottom="32.0" left="44.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="6.0">
                <Label text="Hồ sơ cá nhân" styleClass="page-title"/>
                <Label
                        text="Quản lý thông tin tài khoản, vai trò và trạng thái sử dụng OmniBid."
                        styleClass="page-subtitle"
                        wrapText="true"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="refreshButton"
                    text="Tải lại"
                    styleClass="secondary-button"
                    onAction="#handleRefresh"/>

            <Button
                    text="Về trang chính"
                    styleClass="secondary-button"
                    onAction="#handleBackToHome"/>
        </HBox>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS"
                styleClass="profile-scroll-pane">
            <HBox alignment="TOP_LEFT" fillHeight="true" spacing="18.0" styleClass="profile-content">
                <padding>
                    <Insets top="2.0" right="4.0" bottom="4.0" left="4.0"/>
                </padding>

                <VBox
                        spacing="14.0"
                        minWidth="0.0"
                        prefWidth="0.0"
                        maxWidth="Infinity"
                        styleClass="profile-section-card"
                        HBox.hgrow="ALWAYS">
                    <Label text="Thông tin tài khoản" styleClass="profile-section-title"/>

                    <VBox spacing="8.0" styleClass="profile-info-list">
                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Tên đăng nhập" styleClass="profile-field-title"/>
                            <Label fx:id="usernameLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Email" styleClass="profile-field-title"/>
                            <Label fx:id="emailLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Vai trò" styleClass="profile-field-title"/>
                            <Label fx:id="rolesLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Trạng thái" styleClass="profile-field-title"/>
                            <Label fx:id="accountStatusLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Đánh giá" styleClass="profile-field-title"/>
                            <Label fx:id="ratingLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Đã khôi phục" styleClass="profile-field-title"/>
                            <Label fx:id="restoredLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>
                    </VBox>
                </VBox>

                <VBox
                        spacing="14.0"
                        minWidth="0.0"
                        prefWidth="0.0"
                        maxWidth="Infinity"
                        styleClass="profile-section-card"
                        HBox.hgrow="ALWAYS">
                    <Label text="Ví tài khoản" styleClass="profile-section-title"/>

                    <VBox spacing="8.0" styleClass="profile-info-list">
                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Tổng số dư" styleClass="profile-field-title"/>
                            <Label fx:id="balanceLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-money-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Số dư khả dụng" styleClass="profile-field-title"/>
                            <Label fx:id="availableBalanceLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Đang giữ đặt cọc" styleClass="profile-field-title"/>
                            <Label fx:id="lockedDepositLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Ngày tạo tài khoản" styleClass="profile-field-title"/>
                            <Label fx:id="createdAtLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>

                        <VBox spacing="4.0" styleClass="profile-field-row">
                            <Label text="Cập nhật lần cuối" styleClass="profile-field-title"/>
                            <Label fx:id="updatedAtLabel" text="--" maxWidth="Infinity" wrapText="true" styleClass="profile-field-value"/>
                        </VBox>
                    </VBox>
                </VBox>

                <VBox
                        fx:id="sellerRequestCard"
                        spacing="14.0"
                        minWidth="0.0"
                        prefWidth="0.0"
                        maxWidth="Infinity"
                        styleClass="profile-section-card"
                        HBox.hgrow="ALWAYS">
                    <Label text="Quyền Seller" styleClass="profile-section-title"/>

                    <Label
                            fx:id="sellerRequestHintLabel"
                            text="Bạn có thể gửi yêu cầu mở quyền Seller cho tài khoản này."
                            wrapText="true"
                            styleClass="profile-muted-text"/>

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button
                                fx:id="requestSellerRoleButton"
                                text="Yêu cầu quyền Seller"
                                styleClass="primary-button"
                                onAction="#handleRequestSellerRole"/>
                    </HBox>
                </VBox>
            </HBox>
        </ScrollPane>

        <VBox spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <ProgressIndicator
                        fx:id="loadingIndicator"
                        prefWidth="24.0"
                        prefHeight="24.0"
                        visible="false"
                        managed="false"/>

                <Label
                        fx:id="statusLabel"
                        text="Sẵn sàng."
                        wrapText="true"
                        styleClass="status-label"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </VBox>
    <VBox alignment="CENTER_RIGHT"
          maxHeight="-Infinity"
          maxWidth="-Infinity"
          pickOnBounds="false"
          spacing="2.0"
          StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets top="0.0" right="44.0" bottom="28.0" left="0.0"/>
        </StackPane.margin>

        <fx:include source="../shared/chatbot-launcher.fxml"/>

        <Label styleClass="signature-label" text="by CKNT team"/>
    </VBox>
</StackPane>
