<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.auction.AuctionDetailController"
      styleClass="page-panel" spacing="10">
    <Label fx:id="titleLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <HBox spacing="16">
        <ImageView fx:id="mainImageView" fitWidth="280" preserveRatio="true" pickOnBounds="true"/>
        <FlowPane fx:id="galleryPane" prefWrapLength="400"/>
    </HBox>
    <Label fx:id="statusLabel"/>
    <Label fx:id="priceLabel" styleClass="field-label"/>
    <Label fx:id="reserveLabel"/>
    <Label fx:id="leaderLabel"/>
    <Label fx:id="timeLabel"/>
    <Label fx:id="descLabel" wrapText="true" maxWidth="800"/>
    <HBox spacing="10">
        <Button text="Xem (Watch)" onAction="#onWatch" styleClass="secondary-action-button"/>
        <Button fx:id="joinButton" text="Tham gia (Join)" onAction="#onJoin" styleClass="primary-action-button"/>
        <Button fx:id="payButton" text="Thanh toán" onAction="#onPay" styleClass="primary-action-button" visible="false" managed="false"/>
    </HBox>
</VBox>
