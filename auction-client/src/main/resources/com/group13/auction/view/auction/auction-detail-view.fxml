<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            stylesheets="@../../css/auction.css"
            styleClass="screen-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group13.auction.ui.controller.auction.AuctionDetailController">

    <Pane prefHeight="720.0" prefWidth="1280.0" styleClass="background-layer"/>

    <VBox spacing="20.0"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="26.0" right="42.0" bottom="24.0" left="42.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Button mnemonicParsing="false"
                    onAction="#handleBackToList"
                    styleClass="auction-ghost-button"
                    text="← Danh sách"/>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fitWidth="210.0" preserveRatio="true">
                    <Image url="@../../assets/images/logo.png"/>
                </ImageView>

                <ImageView fitHeight="44.0" preserveRatio="true">
                    <Image url="@../../assets/images/mascot-version-1.png"/>
                </ImageView>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <ProgressIndicator fx:id="loadingIndicator"
                               maxHeight="28.0"
                               maxWidth="28.0"
                               prefHeight="28.0"
                               prefWidth="28.0"
                               visible="false"
                               managed="false"/>

            <Button mnemonicParsing="false"
                    onAction="#handleRefresh"
                    styleClass="auction-secondary-button"
                    text="Tải lại"/>
        </HBox>

        <!-- Main content -->
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="auction-scroll-pane">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets top="4.0" right="4.0" bottom="16.0" left="4.0"/>
                    </padding>

                    <!-- Title card -->
                    <VBox spacing="10.0" styleClass="auction-detail-hero">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="6.0">
                                <Label fx:id="titleLabel"
                                       text="Đang tải phiên đấu giá..."
                                       wrapText="true"
                                       styleClass="auction-detail-title"/>

                                <HBox spacing="10.0">
                                    <Label fx:id="categoryLabel"
                                           text="--"
                                           styleClass="auction-status-badge"/>

                                    <Label fx:id="statusLabel"
                                           text="--"
                                           styleClass="auction-status-badge"/>
                                </HBox>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                                <Label text="Giá hiện tại"
                                       styleClass="auction-muted-text"/>

                                <Label fx:id="currentPriceLabel"
                                       text="--"
                                       styleClass="auction-current-price"/>
                            </VBox>
                        </HBox>

                        <Label fx:id="descriptionLabel"
                               text="Đang tải mô tả sản phẩm..."
                               wrapText="true"
                               styleClass="auction-description-text"/>
                    </VBox>

                    <!-- Metrics -->
                    <GridPane hgap="14.0" vgap="14.0">
                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="0"
                              styleClass="auction-info-box">
                            <Label text="Người bán" styleClass="auction-muted-text"/>
                            <Label fx:id="sellerLabel" text="--" styleClass="auction-info-value"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="0"
                              styleClass="auction-info-box">
                            <Label text="Giá khởi điểm" styleClass="auction-muted-text"/>
                            <Label fx:id="startingPriceLabel" text="--" styleClass="auction-info-value"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2"
                              GridPane.rowIndex="0"
                              styleClass="auction-info-box">
                            <Label text="Giá sàn" styleClass="auction-muted-text"/>
                            <Label fx:id="reservePriceLabel" text="--" styleClass="auction-info-value"/>
                        </VBox>

                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="1"
                              styleClass="auction-info-box">
                            <Label text="Người dẫn đầu" styleClass="auction-muted-text"/>
                            <Label fx:id="leaderLabel" text="--" styleClass="auction-info-value"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="1"
                              styleClass="auction-info-box">
                            <Label text="Lượt xem realtime" styleClass="auction-muted-text"/>
                            <Label fx:id="viewerCountLabel" text="--" styleClass="auction-info-value"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2"
                              GridPane.rowIndex="1"
                              styleClass="auction-info-box">
                            <Label text="Thời gian còn lại" styleClass="auction-muted-text"/>
                            <Label fx:id="remainingTimeLabel" text="--" styleClass="auction-info-value"/>
                        </VBox>
                    </GridPane>

                    <!-- Time card -->
                    <HBox spacing="14.0">
                        <VBox HBox.hgrow="ALWAYS" styleClass="auction-info-box">
                            <Label text="Bắt đầu" styleClass="auction-muted-text"/>
                            <Label fx:id="startTimeLabel" text="--" styleClass="auction-info-value"/>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" styleClass="auction-info-box">
                            <Label text="Kết thúc" styleClass="auction-muted-text"/>
                            <Label fx:id="endTimeLabel" text="--" styleClass="auction-info-value"/>
                        </VBox>
                    </HBox>

                    <!-- Actions -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="auction-action-bar">
                        <Button fx:id="watchLiveButton"
                                mnemonicParsing="false"
                                onAction="#handleWatchLive"
                                styleClass="auction-secondary-button"
                                text="Watch realtime"/>

                        <Button fx:id="joinLiveButton"
                                mnemonicParsing="false"
                                onAction="#handleJoinLive"
                                styleClass="auction-primary-button"
                                text="Join &amp; đặt giá"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="messageLabel"
                               text="Sẵn sàng."
                               wrapText="true"
                               styleClass="auction-muted-text"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Footer signature -->
        <HBox alignment="BOTTOM_RIGHT" spacing="8.0">
            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <ImageView fitHeight="38.0" preserveRatio="true">
                        <Image url="@../../assets/images/mascot-version-2.png"/>
                    </ImageView>

                    <ImageView fitHeight="31.0" preserveRatio="true">
                        <Image url="@../../assets/icons/accent/icon-chatbot.png"/>
                    </ImageView>
                </HBox>

                <Label styleClass="chatbot-label" text="Chat with OMNI"/>
                <Label styleClass="signature-label" text="by CKNT team"/>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>