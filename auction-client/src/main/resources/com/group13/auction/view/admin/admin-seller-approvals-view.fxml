<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.admin.AdminSellerApprovalsController"
      styleClass="page-panel" spacing="10" VBox.vgrow="ALWAYS">
    <Label text="Duyệt yêu cầu nâng cấp Seller" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Danh sách Bidder đang chờ duyệt (chưa có role Seller)." wrapText="true"/>
    <TableView fx:id="pendingTable" VBox.vgrow="ALWAYS" prefHeight="400"/>
    <HBox spacing="10">
        <Button text="Làm mới" onAction="#onRefresh" styleClass="secondary-action-button"/>
        <Button text="Duyệt Seller" onAction="#onApprove" styleClass="primary-action-button"/>
    </HBox>
</VBox>
