<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            stylesheets="@../../css/app.css"
            styleClass="screen-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group13.auction.ui.controller.home.MainLayoutController">

    <Pane prefHeight="720.0" prefWidth="1280.0" styleClass="background-layer"/>

    <VBox spacing="26.0"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="28.0" right="42.0" bottom="28.0" left="42.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="18.0">
            <ImageView fitWidth="250.0" preserveRatio="true">
                <Image url="@../../assets/images/logo.png"/>
            </ImageView>

            <Region HBox.hgrow="ALWAYS"/>

            <Button mnemonicParsing="false"
                    onAction="#handleGoToLanding"
                    text="Landing"/>

            <Button mnemonicParsing="false"
                    onAction="#handleLogout"
                    text="Đăng xuất"/>
        </HBox>

        <!-- Welcome section -->
        <VBox spacing="8.0">
            <Label fx:id="welcomeLabel"
                   text="Xin chào!"
                   style="-fx-font-size: 34px; -fx-font-weight: 800;"/>

            <Label fx:id="accountInfoLabel"
                   text="Đang tải thông tin tài khoản..."
                   wrapText="true"
                   style="-fx-font-size: 15px; -fx-text-fill: rgba(255, 255, 255, 0.76);"/>
        </VBox>

        <!-- Main cards -->
        <HBox spacing="22.0">
            <VBox spacing="14.0"
                  prefWidth="360.0"
                  prefHeight="210.0"
                  style="-fx-background-color: rgba(255, 255, 255, 0.10);
                         -fx-background-radius: 26;
                         -fx-padding: 24;">
                <ImageView fitHeight="46.0" preserveRatio="true">
                    <Image url="@../../assets/icons/accent/icon-auction.png"/>
                </ImageView>

                <Label text="Phiên đấu giá"
                       style="-fx-font-size: 24px; -fx-font-weight: 800;"/>

                <Label text="Xem danh sách phiên đấu giá, mở chi tiết sản phẩm và vào phòng đấu giá realtime."
                       wrapText="true"
                       style="-fx-font-size: 15px; -fx-text-fill: rgba(255, 255, 255, 0.78);"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button mnemonicParsing="false"
                        onAction="#handleOpenAuctionList"
                        text="Mở danh sách phiên đấu giá"/>
            </VBox>

            <VBox spacing="14.0"
                  prefWidth="360.0"
                  prefHeight="210.0"
                  style="-fx-background-color: rgba(255, 255, 255, 0.07);
                         -fx-background-radius: 26;
                         -fx-padding: 24;">
                <ImageView fitHeight="46.0" preserveRatio="true">
                    <Image url="@../../assets/icons/accent/icon-wallet.png"/>
                </ImageView>

                <Label text="Ví &amp; thanh toán"
                       style="-fx-font-size: 24px; -fx-font-weight: 800;"/>

                <Label text="Sẽ nối ở các đợt sau sau khi hoàn thiện auction flow chính."
                       wrapText="true"
                       style="-fx-font-size: 15px; -fx-text-fill: rgba(255, 255, 255, 0.68);"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button disable="true"
                        mnemonicParsing="false"
                        text="Coming soon"/>
            </VBox>

            <VBox spacing="14.0"
                  prefWidth="360.0"
                  prefHeight="210.0"
                  style="-fx-background-color: rgba(255, 255, 255, 0.07);
                         -fx-background-radius: 26;
                         -fx-padding: 24;">
                <ImageView fitHeight="46.0" preserveRatio="true">
                    <Image url="@../../assets/icons/accent/icon-profile.png"/>
                </ImageView>

                <Label text="Hồ sơ cá nhân"
                       style="-fx-font-size: 24px; -fx-font-weight: 800;"/>

                <Label text="Thông tin tài khoản, vai trò Seller/Admin và các chức năng mở rộng."
                       wrapText="true"
                       style="-fx-font-size: 15px; -fx-text-fill: rgba(255, 255, 255, 0.68);"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button disable="true"
                        mnemonicParsing="false"
                        text="Coming soon"/>
            </VBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Mascot + signature -->
        <HBox alignment="BOTTOM_RIGHT" spacing="8.0">
            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <ImageView fitHeight="44.0" preserveRatio="true">
                        <Image url="@../../assets/images/mascot-version-2.png"/>
                    </ImageView>

                    <ImageView fitHeight="34.0" preserveRatio="true">
                        <Image url="@../../assets/icons/accent/icon-chatbot.png"/>
                    </ImageView>
                </HBox>

                <Label styleClass="chatbot-label" text="Chat with OMNI"/>
                <Label styleClass="signature-label" text="by CKNT team"/>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>