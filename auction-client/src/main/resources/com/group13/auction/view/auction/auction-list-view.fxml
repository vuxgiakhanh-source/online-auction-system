<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            stylesheets="@../../css/auction.css"
            styleClass="screen-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group13.auction.ui.controller.auction.AuctionListController">

    <Pane prefHeight="720.0" prefWidth="1280.0" styleClass="background-layer"/>

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                pannable="true"
                styleClass="page-scroll-pane"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">
        <VBox spacing="22.0">
        <padding>
            <Insets top="26.0" right="42.0" bottom="32.0" left="42.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Button mnemonicParsing="false"
                    onAction="#handleBackToHome"
                    styleClass="auction-ghost-button"
                    text="← Dashboard"/>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fitWidth="210.0" preserveRatio="true">
                    <Image url="@../../assets/images/logo.png"/>
                </ImageView>

                <ImageView fitHeight="44.0" preserveRatio="true">
                    <Image url="@../../assets/images/mascot-version-1.png"/>
                </ImageView>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button mnemonicParsing="false"
                    onAction="#handleRefresh"
                    styleClass="auction-secondary-button"
                    text="Tải lại"/>
        </HBox>

        <!-- Title -->
        <VBox spacing="6.0">
            <Label text="Danh sách phiên đấu giá"
                   styleClass="auction-page-title"/>

            <Label text="Theo dõi các phiên đang mở, xem chi tiết sản phẩm và vào phòng đấu giá realtime."
                   wrapText="true"
                   styleClass="auction-page-subtitle"/>
        </VBox>

            <!-- Filter bar -->
            <HBox alignment="CENTER_LEFT"
                  spacing="14.0"
                  styleClass="auction-filter-bar">
                <HBox alignment="CENTER_LEFT"
                      prefWidth="260.0"
                      spacing="8.0"
                      styleClass="auction-search-box">
                    <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                        <Image url="@../../assets/icons/accent/icon-search.png"/>
                    </ImageView>

                    <TextField fx:id="productSearchField"
                               promptText="Tìm tên sản phẩm..."
                               HBox.hgrow="ALWAYS"
                               styleClass="auction-search-field"/>
                </HBox>

                <HBox fx:id="scopeFilterGroup"
                      alignment="CENTER_LEFT"
                      spacing="8.0">
                    <Label text="Phạm vi"
                           styleClass="auction-filter-label"/>

                    <ComboBox fx:id="scopeFilterComboBox"
                              prefWidth="190.0"
                              styleClass="auction-combo-box"/>
                </HBox>

                <Label text="Trạng thái"
                       styleClass="auction-filter-label"/>

                <ComboBox fx:id="statusFilterComboBox"
                          prefWidth="180.0"
                          styleClass="auction-combo-box"/>

                <Label text="Sắp xếp"
                       styleClass="auction-filter-label"/>

                <ComboBox fx:id="sortByComboBox"
                          prefWidth="190.0"
                          styleClass="auction-combo-box"/>

                <Button mnemonicParsing="false"
                        onAction="#handleApplyFilter"
                        styleClass="auction-primary-button"
                        text="Áp dụng"/>

            <Region HBox.hgrow="ALWAYS"/>

            <ProgressIndicator fx:id="loadingIndicator"
                               maxHeight="28.0"
                               maxWidth="28.0"
                               prefHeight="28.0"
                               prefWidth="28.0"
                               visible="false"
                               managed="false"/>

            <Label fx:id="statusLabel"
                   text="Sẵn sàng."
                   styleClass="auction-muted-text"/>
        </HBox>

        <!-- Auction list -->
        <VBox fx:id="auctionCardContainer"
              spacing="14.0"
              styleClass="auction-list-container">
            <padding>
                <Insets top="6.0" right="4.0" bottom="12.0" left="4.0"/>
            </padding>
        </VBox>
        </VBox>
    </ScrollPane>
    <VBox alignment="CENTER_RIGHT"
          maxHeight="-Infinity"
          maxWidth="-Infinity"
          pickOnBounds="false"
          spacing="2.0"
          AnchorPane.bottomAnchor="28.0"
          AnchorPane.rightAnchor="44.0">
        <fx:include source="../shared/chatbot-launcher.fxml"/>

        <Label styleClass="signature-label" text="by CKNT team"/>
    </VBox>
</AnchorPane>
