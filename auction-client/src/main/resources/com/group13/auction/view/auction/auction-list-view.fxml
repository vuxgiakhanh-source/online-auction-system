<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.auction.AuctionListController"
      styleClass="page-panel" spacing="12" VBox.vgrow="ALWAYS">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Lọc trạng thái:" styleClass="field-label"/>
        <ComboBox fx:id="statusFilter" prefWidth="160"/>
        <Button text="Làm mới" onAction="#onRefresh" styleClass="primary-action-button"/>
    </HBox>
    <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" styleClass="data-table"/>
</VBox>
