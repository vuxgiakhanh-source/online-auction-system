<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            stylesheets="@../../css/seller.css"
            styleClass="screen-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group13.auction.ui.controller.seller.SellerAuctionListController">

    <Pane prefHeight="720.0" prefWidth="1280.0" styleClass="background-layer"/>

    <VBox spacing="22.0"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="26.0" right="42.0" bottom="26.0" left="42.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Button mnemonicParsing="false"
                    onAction="#handleBackToSellerDashboard"
                    styleClass="seller-ghost-button"
                    text="← Kênh Seller"/>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fitWidth="210.0" preserveRatio="true">
                    <Image url="@../../assets/images/logo.png"/>
                </ImageView>

                <ImageView fitHeight="44.0" preserveRatio="true">
                    <Image url="@../../assets/images/mascot-version-1.png"/>
                </ImageView>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button mnemonicParsing="false"
                    onAction="#handleCreateAuction"
                    styleClass="seller-primary-button"
                    text="Tạo phiên mới"/>

            <Button mnemonicParsing="false"
                    onAction="#handleRefresh"
                    styleClass="seller-secondary-button"
                    text="Tải lại"/>
        </HBox>

        <!-- Title -->
        <VBox spacing="6.0">
            <Label text="Phiên đấu giá của người bán"
                   styleClass="seller-page-title"/>

            <Label text="Theo dõi các phiên đã tạo, kiểm tra trạng thái và gửi yêu cầu hủy đối với phiên chưa mở."
                   wrapText="true"
                   styleClass="seller-page-subtitle"/>
        </VBox>

        <!-- Filter -->
        <HBox alignment="CENTER_LEFT"
              spacing="14.0"
              styleClass="seller-filter-bar">
            <Label text="Trạng thái"
                   styleClass="seller-filter-label"/>

            <ComboBox fx:id="statusFilterComboBox"
                      prefWidth="220.0"
                      styleClass="seller-combo-box"/>

            <Button mnemonicParsing="false"
                    onAction="#handleApplyFilter"
                    styleClass="seller-primary-button"
                    text="Áp dụng"/>

            <Region HBox.hgrow="ALWAYS"/>

            <ProgressIndicator fx:id="loadingIndicator"
                               maxHeight="28.0"
                               maxWidth="28.0"
                               prefHeight="28.0"
                               prefWidth="28.0"
                               visible="false"
                               managed="false"/>

            <Label fx:id="statusLabel"
                   text="Sẵn sàng."
                   styleClass="seller-muted-text"/>
        </HBox>

        <!-- List -->
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="seller-scroll-pane">
            <VBox fx:id="sellerAuctionContainer"
                  spacing="14.0"
                  styleClass="seller-list-container">
                <padding>
                    <Insets top="6.0" right="4.0" bottom="12.0" left="4.0"/>
                </padding>
            </VBox>
        </ScrollPane>

        <!-- Footer -->
        <HBox alignment="BOTTOM_RIGHT" spacing="8.0">
            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <ImageView fitHeight="40.0" preserveRatio="true">
                        <Image url="@../../assets/images/mascot-version-2.png"/>
                    </ImageView>

                    <ImageView fitHeight="32.0" preserveRatio="true">
                        <Image url="@../../assets/icons/accent/icon-chatbot.png"/>
                    </ImageView>
                </HBox>

                <Label styleClass="chatbot-label" text="Chat with OMNI"/>
                <Label styleClass="signature-label" text="by CKNT team"/>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>