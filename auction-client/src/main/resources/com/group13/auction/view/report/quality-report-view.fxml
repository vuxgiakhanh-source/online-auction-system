<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.report.QualityReportController"
      styleClass="page-panel" spacing="10">
    <TextArea fx:id="descArea" promptText="Mô tả vấn đề chất lượng" prefRowCount="4"/>
    <Button text="Upload bằng chứng" onAction="#onUploadEvidence"/>
    <Label fx:id="evidenceLabel"/>
    <Button text="Gửi báo cáo" onAction="#onSubmit" styleClass="primary-action-button"/>
</VBox>
