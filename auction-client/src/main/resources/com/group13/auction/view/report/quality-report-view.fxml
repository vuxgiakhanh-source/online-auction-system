<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        prefWidth="1280.0"
        prefHeight="720.0"
        styleClass="screen-root"
        stylesheets="@../../css/report.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.group13.auction.ui.controller.report.QualityReportController">

    <VBox spacing="20.0" styleClass="report-page">
        <padding>
            <Insets top="32.0" right="44.0" bottom="32.0" left="44.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="6.0">
                <Label text="Báo cáo chất lượng đơn hàng" styleClass="page-title"/>
                <Label
                        text="Gửi thông tin phản hồi cho đơn hàng đã thanh toán khi sản phẩm nhận được có vấn đề."
                        styleClass="page-subtitle"
                        wrapText="true"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="backButton"
                    text="Quay lại đơn hàng"
                    styleClass="secondary-button"
                    onAction="#handleBackToOrders"/>
        </HBox>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS"
                styleClass="report-scroll-pane">
            <VBox spacing="18.0" styleClass="report-content">
                <padding>
                    <Insets top="2.0" right="4.0" bottom="4.0" left="4.0"/>
                </padding>

                <VBox spacing="14.0" styleClass="report-section-card">
                    <Label text="Thông tin đơn hàng" styleClass="report-section-title"/>

                    <GridPane hgap="18.0" vgap="12.0" styleClass="report-info-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="22.0"/>
                            <ColumnConstraints percentWidth="28.0"/>
                            <ColumnConstraints percentWidth="22.0"/>
                            <ColumnConstraints percentWidth="28.0"/>
                        </columnConstraints>

                        <Label
                                text="Sản phẩm"
                                styleClass="report-field-title"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="itemNameLabel"
                                text="--"
                                wrapText="true"
                                styleClass="report-field-value"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Người bán"
                                styleClass="report-field-title"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="2"/>
                        <Label
                                fx:id="sellerLabel"
                                text="--"
                                wrapText="true"
                                styleClass="report-field-value"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Giá thắng"
                                styleClass="report-field-title"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="winningPriceLabel"
                                text="--"
                                wrapText="true"
                                styleClass="report-field-value"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="1"/>

                        <Label
                                text="Trạng thái"
                                styleClass="report-field-title"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="2"/>
                        <Label
                                fx:id="orderStatusLabel"
                                text="--"
                                wrapText="true"
                                styleClass="report-field-value"
                                GridPane.rowIndex="1"
                                GridPane.columnIndex="3"/>

                        <Label
                                text="Mã phiên"
                                styleClass="report-field-title"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="0"/>
                        <Label
                                fx:id="auctionIdLabel"
                                text="--"
                                wrapText="true"
                                styleClass="report-field-value muted-id"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="1"
                                GridPane.columnSpan="3"/>
                    </GridPane>
                </VBox>

                <VBox spacing="14.0" styleClass="report-section-card">
                    <Label text="Nội dung báo cáo" styleClass="report-section-title"/>

                    <Label
                            text="Mô tả vấn đề bạn gặp phải"
                            styleClass="report-field-title"/>

                    <TextArea
                            fx:id="descriptionArea"
                            prefRowCount="7"
                            wrapText="true"
                            promptText="Ví dụ: sản phẩm không đúng mô tả, bị hư hỏng, thiếu phụ kiện..."
                            styleClass="report-text-area"/>

                    <VBox spacing="10.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Ảnh bằng chứng" styleClass="report-field-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button
                                    fx:id="chooseImagesButton"
                                    text="Chọn ảnh"
                                    styleClass="secondary-button"
                                    onAction="#handleChooseImages"/>

                            <Button
                                    fx:id="removeSelectedImageButton"
                                    text="Xóa ảnh đã chọn"
                                    styleClass="secondary-button"
                                    onAction="#handleRemoveSelectedImage"/>

                            <Button
                                    fx:id="clearImagesButton"
                                    text="Xóa tất cả"
                                    styleClass="secondary-button"
                                    onAction="#handleClearImages"/>
                        </HBox>

                        <ListView
                                fx:id="selectedImagesListView"
                                prefHeight="120.0"
                                styleClass="report-image-list"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <VBox spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <ProgressIndicator
                        fx:id="loadingIndicator"
                        prefWidth="24.0"
                        prefHeight="24.0"
                        visible="false"
                        managed="false"/>

                <VBox spacing="4.0">
                    <Label
                            fx:id="statusLabel"
                            text="Sẵn sàng."
                            wrapText="true"
                            styleClass="status-label"/>

                    <Label
                            fx:id="resultLabel"
                            text=""
                            visible="false"
                            managed="false"
                            wrapText="true"
                            styleClass="report-result-label"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="clearButton"
                        text="Xóa nội dung"
                        styleClass="secondary-button"
                        onAction="#handleClearForm"/>

                <Button
                        fx:id="submitButton"
                        text="Gửi báo cáo"
                        styleClass="primary-button"
                        onAction="#handleSubmitReport"/>
            </HBox>

            <HBox alignment="BOTTOM_RIGHT" spacing="8.0">
                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <fx:include source="../shared/chatbot-launcher.fxml"/>

                    <Label styleClass="signature-label" text="by CKNT team"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</StackPane>