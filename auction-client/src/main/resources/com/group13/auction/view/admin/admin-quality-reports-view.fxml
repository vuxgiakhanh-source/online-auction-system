<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.admin.AdminQualityReportsController"
      styleClass="page-panel" spacing="10" VBox.vgrow="ALWAYS">
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10">
        <Button text="Approve" onAction="#onApprove" styleClass="primary-action-button"/>
        <Button text="Reject" onAction="#onReject" styleClass="secondary-action-button"/>
    </HBox>
</VBox>
