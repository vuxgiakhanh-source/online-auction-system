<?xml version="1.0" encoding="UTF-8"?>

<?import com.group13.auction.ui.component.BidPriceChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.auction.LiveBiddingController"
      styleClass="page-panel" spacing="10" VBox.vgrow="ALWAYS">
    <Label fx:id="infoLabel" styleClass="field-label"/>
    <Label fx:id="phaseLabel"/>
    <BidPriceChart fx:id="bidChart" VBox.vgrow="ALWAYS" prefHeight="280" minHeight="200"/>
    <ListView fx:id="historyList" prefHeight="100"/>
    <HBox spacing="10">
        <TextField fx:id="bidAmountField" promptText="Giá bid" prefWidth="140"/>
        <Button text="Đặt giá" onAction="#onPlaceBid" styleClass="primary-action-button"/>
        <TextField fx:id="maxBidField" promptText="Max auto-bid" prefWidth="140"/>
        <Button text="Auto-bid" onAction="#onRegisterAutoBid" styleClass="secondary-action-button"/>
        <Button text="Rời phòng" onAction="#onLeave" styleClass="secondary-action-button"/>
    </HBox>
</VBox>
