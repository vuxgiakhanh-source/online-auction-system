<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            stylesheets="@../../css/auction.css"
            styleClass="screen-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group13.auction.ui.controller.auction.LiveBiddingController">

    <Pane prefHeight="720.0" prefWidth="1280.0" styleClass="background-layer"/>

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                pannable="true"
                styleClass="page-scroll-pane"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">
        <VBox spacing="18.0">
            <padding>
                <Insets top="24.0" right="42.0" bottom="132.0" left="42.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Button mnemonicParsing="false"
                        onAction="#handleBackToDetail"
                        styleClass="auction-ghost-button"
                        text="← Chi tiết"/>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ImageView fitWidth="210.0" preserveRatio="true">
                        <Image url="@../../assets/images/logo.png"/>
                    </ImageView>

                    <ImageView fitHeight="44.0" preserveRatio="true">
                        <Image url="@../../assets/images/mascot-version-1.png"/>
                    </ImageView>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <ProgressIndicator fx:id="loadingIndicator"
                                   maxHeight="28.0"
                                   maxWidth="28.0"
                                   prefHeight="28.0"
                                   prefWidth="28.0"
                                   visible="false"
                                   managed="false"/>

                <Button mnemonicParsing="false"
                        onAction="#handleRefreshHistory"
                        styleClass="auction-secondary-button"
                        text="Tải lại lịch sử"/>
            </HBox>

            <HBox alignment="TOP_LEFT" spacing="18.0" styleClass="auction-detail-hero">
                <VBox spacing="8.0" HBox.hgrow="ALWAYS" minWidth="0.0" maxWidth="Infinity">
                    <Label fx:id="titleLabel"
                           text="Đang kết nối phòng đấu giá..."
                           wrapText="true"
                           maxWidth="Infinity"
                           styleClass="auction-detail-title"/>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label fx:id="statusLabel"
                               text="--"
                               styleClass="auction-status-badge"/>

                        <Label fx:id="endTimeLabel"
                               text="--"
                               styleClass="auction-status-badge"/>

                        <HBox alignment="CENTER" spacing="8.0" styleClass="live-countdown-pill">
                            <Label text="Còn lại"
                                   styleClass="live-countdown-pill-label"/>

                            <Label fx:id="countdownLabel"
                                   text="--:--"
                                   styleClass="live-countdown-pill-value"/>
                        </HBox>
                    </HBox>
                </VBox>

                <VBox alignment="CENTER_RIGHT" spacing="4.0" minWidth="180.0" maxWidth="280.0">
                    <Label text="Giá hiện tại"
                           styleClass="auction-muted-text"/>

                    <Label fx:id="currentPriceLabel"
                           text="--"
                           wrapText="true"
                           maxWidth="Infinity"
                           styleClass="auction-current-price"/>
                </VBox>
            </HBox>

            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                <VBox spacing="14.0" prefWidth="420.0">
                    <VBox spacing="10.0" styleClass="auction-info-box">
                        <Label text="Thông tin realtime"
                               styleClass="auction-section-title"/>

                        <Label fx:id="leaderLabel"
                               text="Người dẫn đầu: --"
                               wrapText="true"
                               styleClass="auction-info-value"/>

                        <Label fx:id="reserveLabel"
                               text="Trạng thái giá sàn: --"
                               wrapText="true"
                               styleClass="auction-muted-text"/>

                        <Label fx:id="messageLabel"
                               text="Sẵn sàng."
                               wrapText="true"
                               styleClass="auction-muted-text"/>
                    </VBox>

                    <VBox spacing="12.0" styleClass="auction-info-box">
                        <Label text="Đặt giá"
                               styleClass="auction-section-title"/>

                        <TextField fx:id="bidAmountField"
                                   promptText="Nhập giá muốn đặt"
                                   styleClass="auction-input"/>

                        <Label fx:id="minimumBidHintLabel"
                               text="Bước giá tối thiểu: --"
                               wrapText="true"
                               styleClass="auction-muted-text"/>

                        <Button fx:id="placeBidButton"
                                mnemonicParsing="false"
                                onAction="#handlePlaceBid"
                                styleClass="auction-primary-button"
                                text="Gửi giá đặt"/>
                    </VBox>

                    <VBox spacing="12.0" styleClass="auction-info-box">
                        <Label text="Auto-Bid"
                               styleClass="auction-section-title"/>

                        <Label fx:id="autoBidStatusLabel"
                               text="Chưa tải trạng thái auto-bid."
                               wrapText="true"
                               styleClass="auction-muted-text"/>

                        <TextField fx:id="autoBidMaxField"
                                   promptText="Giá tối đa cho auto-bid, tối thiểu 1000"
                                   styleClass="auction-input"/>

                        <Label text="Bước giá sẽ do hệ thống tự tính theo giá hiện tại của phiên."
                               wrapText="true"
                               styleClass="auction-muted-text"/>

                        <HBox spacing="8.0">
                            <Button fx:id="registerAutoBidButton"
                                    mnemonicParsing="false"
                                    onAction="#handleRegisterAutoBid"
                                    styleClass="auction-primary-button"
                                    text="Bật"/>

                            <Button fx:id="updateAutoBidButton"
                                    mnemonicParsing="false"
                                    onAction="#handleUpdateAutoBid"
                                    styleClass="auction-secondary-button"
                                    text="Cập nhật"/>

                            <Button fx:id="cancelAutoBidButton"
                                    mnemonicParsing="false"
                                    onAction="#handleCancelAutoBid"
                                    styleClass="auction-ghost-button"
                                    text="Hủy"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0"
                          VBox.vgrow="ALWAYS"
                          onMouseClicked="#handleOpenBidHistoryPreview"
                          styleClass="auction-info-box live-previewable-card">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Lịch sử đặt giá"
                                   styleClass="auction-section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Phóng to ↗"
                                   styleClass="live-expand-badge"/>
                        </HBox>

                        <Label text="Bấm vào khung này để xem toàn bộ lịch sử ở dạng bảng lớn (tối đa 200 lượt gần nhất)."
                               wrapText="true"
                               styleClass="auction-muted-text"/>

                        <ListView fx:id="bidHistoryListView"
                                  minHeight="260.0"
                                  prefHeight="280.0"
                                  VBox.vgrow="ALWAYS"
                                  styleClass="auction-history-list"/>
                    </VBox>
                </VBox>

                <VBox spacing="12.0"
                      HBox.hgrow="ALWAYS"
                      onMouseClicked="#handleOpenChartPreview"
                      styleClass="auction-info-box live-previewable-card">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Biểu đồ giá realtime"
                               styleClass="auction-section-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Phóng to ↗"
                               styleClass="live-expand-badge"/>
                    </HBox>

                    <Label text="Mỗi bid hợp lệ từ server sẽ cập nhật đường giá theo thời gian thực. Bấm vào khung này để xem biểu đồ lớn."
                           wrapText="true"
                           styleClass="auction-muted-text"/>

                    <LineChart fx:id="bidLineChart"
                               animated="false"
                               legendVisible="false"
                               VBox.vgrow="ALWAYS"
                               minHeight="360.0"
                               prefHeight="420.0"
                               styleClass="auction-line-chart">
                        <xAxis>
                            <CategoryAxis label="Thời gian"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Giá"/>
                        </yAxis>
                    </LineChart>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
    <VBox alignment="CENTER_RIGHT"
          maxHeight="-Infinity"
          maxWidth="-Infinity"
          pickOnBounds="false"
          spacing="2.0"
          AnchorPane.bottomAnchor="28.0"
          AnchorPane.rightAnchor="44.0">
        <fx:include source="../shared/chatbot-launcher.fxml"/>

        <Label styleClass="signature-label" text="by CKNT team"/>
    </VBox>
</AnchorPane>
