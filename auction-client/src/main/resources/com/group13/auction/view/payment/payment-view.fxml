<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.payment.PaymentController"
      styleClass="page-panel" spacing="10">
    <Label text="Phiên:" styleClass="field-label"/>
    <Label fx:id="auctionIdLabel"/>
    <Label fx:id="statusLabel" wrapText="true" maxWidth="600"/>
    <Button text="Thanh toán ngay" onAction="#onPay" styleClass="primary-action-button"/>
    <Label fx:id="resultLabel" wrapText="true" maxWidth="600" styleClass="field-label"/>
</VBox>
