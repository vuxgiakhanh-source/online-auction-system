<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0"
            stylesheets="@../../css/seller.css"
            styleClass="screen-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group13.auction.ui.controller.seller.EditAuctionController">

    <Pane prefHeight="720.0" prefWidth="1280.0" styleClass="background-layer"/>

    <VBox spacing="24.0"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="26.0" right="42.0" bottom="26.0" left="42.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Button mnemonicParsing="false"
                    onAction="#handleBackToSellerList"
                    styleClass="seller-ghost-button"
                    text="← Danh sách phiên"/>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fitWidth="210.0" preserveRatio="true">
                    <Image url="@../../assets/images/logo.png"/>
                </ImageView>

                <ImageView fitHeight="44.0" preserveRatio="true">
                    <Image url="@../../assets/images/mascot-version-1.png"/>
                </ImageView>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <ProgressIndicator fx:id="loadingIndicator"
                               maxHeight="28.0"
                               maxWidth="28.0"
                               prefHeight="28.0"
                               prefWidth="28.0"
                               visible="false"
                               managed="false"/>
        </HBox>

        <!-- Title -->
        <VBox spacing="6.0">
            <Label text="Gia hạn thời gian kết thúc"
                   styleClass="seller-page-title"/>

            <Label text="Chỉ phiên đấu giá chưa mở mới có thể được gia hạn thời gian kết thúc."
                   wrapText="true"
                   styleClass="seller-page-subtitle"/>
        </VBox>

        <!-- Form -->
        <VBox spacing="20.0"
              maxWidth="760.0"
              styleClass="seller-form-card">
            <padding>
                <Insets top="26.0" right="30.0" bottom="26.0" left="30.0"/>
            </padding>

            <VBox spacing="7.0">
                <Label fx:id="itemNameLabel"
                       text="Tên sản phẩm"
                       styleClass="seller-card-title"/>

                <Label fx:id="auctionIdLabel"
                       text="Mã phiên"
                       styleClass="seller-muted-text"/>

                <Label fx:id="statusLabel"
                       text="Trạng thái"
                       styleClass="seller-muted-text"/>

                <Label fx:id="currentEndTimeLabel"
                       text="Thời gian kết thúc hiện tại"
                       styleClass="seller-muted-text"/>
            </VBox>

            <HBox spacing="16.0">
                <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                    <Label text="Ngày kết thúc mới"
                           styleClass="seller-form-label"/>

                    <DatePicker fx:id="newEndDatePicker"
                                prefWidth="360.0"
                                styleClass="seller-date-picker"/>
                </VBox>

                <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                    <Label text="Giờ kết thúc mới"
                           styleClass="seller-form-label"/>

                    <TextField fx:id="newEndTimeField"
                               promptText="HH:mm"
                               styleClass="seller-text-field"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Button fx:id="saveButton"
                        mnemonicParsing="false"
                        onAction="#handleSave"
                        styleClass="seller-primary-button"
                        text="Cập nhật thời gian"/>

                <Button fx:id="resetButton"
                        mnemonicParsing="false"
                        onAction="#handleReset"
                        styleClass="seller-secondary-button"
                        text="Đặt lại"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="messageLabel"
                       text="Sẵn sàng."
                       styleClass="seller-muted-text"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Footer -->
        <HBox alignment="BOTTOM_RIGHT" spacing="8.0">
            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <ImageView fitHeight="40.0" preserveRatio="true">
                        <Image url="@../../assets/images/mascot-version-2.png"/>
                    </ImageView>

                    <ImageView fitHeight="32.0" preserveRatio="true">
                        <Image url="@../../assets/icons/accent/icon-chatbot.png"/>
                    </ImageView>
                </HBox>

                <Label styleClass="chatbot-label" text="Chat with OMNI"/>
                <Label styleClass="signature-label" text="by CKNT team"/>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>