<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group13.auction.ui.controller.seller.EditAuctionController"
      styleClass="page-panel" spacing="10">
    <Label text="Sửa phiên đấu giá" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="auctionIdLabel"/>
    <Label text="Giá dự trữ mới (VND)"/>
    <TextField fx:id="reserveField" promptText="Để trống nếu không đổi"/>
    <Label text="Ngày kết thúc mới"/>
    <DatePicker fx:id="endDate"/>
    <Label fx:id="statusLabel" wrapText="true"/>
    <Button text="Lưu thay đổi" onAction="#onSave" styleClass="primary-action-button"/>
    <Button text="Hủy" onAction="#onCancel" styleClass="secondary-action-button"/>
</VBox>
